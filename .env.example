# ───────── Núcleo ─────────
# URL pública da aplicação (usada em links de descadastro e webhooks)
APP_URL=http://localhost:3000
# Chave de 32 bytes em base64 para cifrar segredos de integração (AES-256-GCM).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Segredo para assinar links de descadastro e proteger o cron
APP_SECRET=
CRON_SECRET=

# ───────── Banco ─────────
# Vazio = PGlite local em ./.data/pglite (desenvolvimento).
# Produção (Supabase): Project Settings → Database → Connection string (pooler, modo transaction)
DATABASE_URL=

# ───────── IA (Claude) ─────────
# Vazio = agente em "modo básico" (interpretador de regras, sem IA generativa).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ───────── Canais (opcional; também configuráveis por empresa em Integrações) ─────────
# Verificação de webhook do WhatsApp Cloud API (Meta)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ───────── Google Agenda (opcional; botão "Conectar com Google" em Conexões) ─────────
# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: <APP_URL>/api/sources/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ───────── Cobrança da assinatura (Asaas) ─────────
# Vazio = cobrança desativada e todos os recursos liberados (comportamento atual).
# Comece SEMPRE no sandbox: https://sandbox.asaas.com → Integrações → Chave de API.
ASAAS_API_KEY=
# sandbox (padrão, sem dinheiro real) | production
ASAAS_ENV=sandbox
# Token que você define no painel do Asaas ao cadastrar o webhook <APP_URL>/api/webhooks/asaas
ASAAS_WEBHOOK_TOKEN=
# true/false força ligar/desligar o bloqueio por falta de pagamento (padrão: ligado se ASAAS_API_KEY existir)
BILLING_ENFORCE=
# Dias de teste grátis para empresas novas e dias de tolerância após vencimento (decisão comercial sua)
BILLING_TRIAL_DAYS=7
BILLING_GRACE_DAYS=3

# ───────── E-mails transacionais (recuperar senha, confirmar e-mail) ─────────
# Vazio em desenvolvimento = o link aparece no terminal do servidor.
RESEND_API_KEY=
EMAIL_FROM=GravitaSolves <no-reply@seudominio.com.br>
